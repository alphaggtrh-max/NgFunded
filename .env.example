# NGFunded Environment Configuration
# Copy this file to .env.local and fill in your values

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/ngfunded?schema=public"

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Auth ────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="REPLACE_WITH_STRONG_SECRET"
NEXTAUTH_URL="http://localhost:3000"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WS_URL="ws://localhost:3001"
NODE_ENV="development"

# ─── Risk Engine ─────────────────────────────────────────────────────────────
RISK_ENGINE_PORT=3001
RISK_CHECK_INTERVAL_MS=50

# ─── Market Data ─────────────────────────────────────────────────────────────
# NgFunded is always paper trading. MT5 is used only as a real-time price source.
MARKET_DATA_PROVIDER="mt5"
MT5_SYMBOLS="EURUSD,GBPUSD,USDJPY,XAUUSD,NAS100,US30"
MT5_POLL_INTERVAL_MS=100
# Optional: absolute path to terminal64.exe on the MT5 host.
MT5_TERMINAL_PATH=""
MT5_LOGIN=""
MT5_PASSWORD=""
MT5_SERVER=""

# ─── TradingView / Paper Broker ─────────────────────────────────────────────
# Required before the webhook endpoint accepts requests.
TRADINGVIEW_WEBHOOK_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"
