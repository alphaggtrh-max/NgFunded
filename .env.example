# NGFunded Environment Configuration
# Copy this file to .env.local and fill in your values

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/ngfunded?schema=public"

# ─── Redis ───────────────────────────────────────────────────────────────────
# Vercel Redis integration variable used by the production app.
ngfunded_REDIS_URL="redis://localhost:6379"
# REDIS_URL is also supported for local development/backwards compatibility.

# ─── Auth ────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="REPLACE_WITH_STRONG_SECRET"
NEXTAUTH_URL="http://localhost:3000"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WS_URL="ws://localhost:3001"
NODE_ENV="development"

# ─── Payments ────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_REPLACE_ME"

# ─── Risk Engine ─────────────────────────────────────────────────────────────
RISK_ENGINE_PORT=3001
RISK_CHECK_INTERVAL_MS=50

# ─── Market Data ─────────────────────────────────────────────────────────────
# Server-side market data provider. Never expose this key as NEXT_PUBLIC_*.
# Massive provides live forex quotes and OHLC data for the trading chart.
MARKET_DATA_PROVIDER="massive"
MASSIVE_API_KEY="REPLACE_WITH_MASSIVE_API_KEY"
MT5_SYMBOLS="EURUSD,GBPUSD,USDJPY,XAUUSD,NAS100,US30"
MT5_POLL_INTERVAL_MS=100
MT5_TERMINAL_PATH=""
MT5_LOGIN=""
MT5_PASSWORD=""
MT5_SERVER=""

# ─── TradingView / Paper Broker ──────────────────────────────────────────────
TRADINGVIEW_WEBHOOK_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"
