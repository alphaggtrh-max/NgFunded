# NGFunded Environment Configuration
# Copy this file to .env.local and fill in your values

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/ngfunded?schema=public"

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Auth ────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="REPLACE_WITH_STRONG_SECRET"
NEXTAUTH_URL="http://localhost:3000"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WS_URL="ws://localhost:3001"
NODE_ENV="development"

# ─── Risk Engine ─────────────────────────────────────────────────────────────
RISK_ENGINE_PORT=3001
RISK_CHECK_INTERVAL_MS=50

# ─── TradingView / Paper Broker ─────────────────────────────────────────────
# Required before the webhook endpoint accepts requests.
TRADINGVIEW_WEBHOOK_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"
